# Nusxa oling: cp .env.example .env  (.env commit qilinmaydi)
TELEGRAM_BOT_TOKEN=123456:replace-me
# Vergul bilan ajratilgan Telegram user ID'lar (@userinfobot orqali bilish mumkin)
TELEGRAM_ALLOWED_USER_IDS=111111111

# STT: whisper-cpp | stub
STT_ENGINE=whisper-cpp
# Dev: native whisper-server (scripts/whisper-dev.sh). Server: Docker'dagi whisper (Tailscale IP).
STT_WHISPER_URL=http://127.0.0.1:8178
# /lang bilan til tanlamagan foydalanuvchi uchun
STT_DEFAULT_LANGUAGE=uz
STT_WHISPER_TIMEOUT=15m

# PostgreSQL (dev: docker compose up -d postgres). Serverda DB_PASSWORD'ni albatta o'zgartiring.
DB_URL=jdbc:postgresql://127.0.0.1:5433/voicedevbot
DB_USER=voicedevbot
DB_PASSWORD=voicedevbot
